{
  "description": "wb-pet-bridge: WorkBuddy 会话状态 -> dsh-pet 桌宠（本地文件总线，不联网）",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${CODEBUDDY_PLUGIN_ROOT}/scripts/emit.ps1\" -State thinking",
            "description": "会话开始：桌宠进入思考态",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${CODEBUDDY_PLUGIN_ROOT}/scripts/emit.ps1\" -State working",
            "description": "工具调用：桌宠进入干活态（去重后不会重复写）",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${CODEBUDDY_PLUGIN_ROOT}/scripts/emit.ps1\" -State idle",
            "description": "会话结束：桌宠收工并弹完成气泡",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
